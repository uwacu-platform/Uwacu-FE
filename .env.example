# UWACU Frontend Environment Variables Example Template
# Copy this file to .env and adjust values for local development or staging.

# Backend API Base URL (e.g. http://localhost:5000/api for local backend)
VITE_API_BASE_URL=https://uwacu.onrender.com/api

# Storage Keys
VITE_TOKEN_STORAGE_KEY=uwacu_access_token
VITE_SESSION_STORAGE_KEY=uwacu_auth_user

# Network & Retry Configuration
VITE_API_TIMEOUT=10000
VITE_RETRY_ATTEMPTS=1
VITE_RETRY_DELAY_MS=2000
